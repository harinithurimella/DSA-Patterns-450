using System;

public class HelloWorld
{
    public static void Main(string[] args)
    {
        int[] arr = {2, 4, 6, 7, 8};
        int length = arr.Length;

        for (int i = 0; i < length / 2; i++)
        {
            int temp = arr[i];
            arr[i] = arr[length - i - 1];
            arr[length - i - 1] = temp;
        }
        foreach (int num in arr)
        {
            Console.WriteLine(num + " ");
        }
    }
}

